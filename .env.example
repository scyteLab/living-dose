# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
# Never commit .env.local — it is already in .gitignore.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Default region and language (people can change both in the app)
VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_REGION=NG

# Online payments: set to true once Paystack is set up (see supabase/PAYMENTS.md)
VITE_PAYSTACK_ENABLED=false

# Phone codes: set to true once an SMS provider is set up in Supabase (Authentication → Providers → Phone)
VITE_PHONE_AUTH_ENABLED=false

# AI photo checks (Snap your plate, water selfie). Set these in Netlify, not here:
# they only run in the Netlify function, never in the browser.
# GEMINI_API_KEY=      free key from aistudio.google.com
# ANTHROPIC_API_KEY=   paid key from console.anthropic.com
# AI_PROVIDER=         gemini or claude, only needed if both keys are set
